# Disable directory browsing
Options -Indexes

RewriteEngine On

# Error Documents
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Deny direct access to sensitive data files and system files
<FilesMatch "\.(csv|log|ini|env|sql|bak|sh|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 1. Redirect /index.html or /index to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]

# 2. Redirect any requested .html file to its extensionless clean URL (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Internally map extensionless URL to existing .html file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [NC,L]
